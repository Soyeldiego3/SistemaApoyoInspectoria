{
  "name": "apoyo-inspectoria",
  "version": "1.0.0",
  "description": "Sistema de Apoyo Inspectoría",
  "main": "main.js",
  "author": "Diego Saravia, Victor Jara",
  "scripts": {
    "start": "electron .",
    "build:front": "npm --prefix ../inspectoria-front run build",
    "prepare:back": "node scripts/prepare-back.js",
    "pack": "npm run build:front && npm run prepare:back && electron-builder --dir",
    "dist": "npm run build:front && npm run prepare:back && electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "cl.inacap.apoyoinspectoria",
    "productName": "Apoyo Inspectoria",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "back-build",
        "to": "inspectoria-back",
        "filter": [
          "**/*",
          "node_modules/**/*",
          "!src/node_modules/**/*"
        ]
      },
      {
        "from": "back-build/src/node_modules",
        "to": "inspectoria-back/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "front-dist",
        "to": "front-dist"
      },
      {
        "from": "browsers",
        "to": "browsers"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "icon": "assets/icons/icon.png"
    }
  }
}
