{
  "name": "apoyo-inspectoria",
  "version": "1.0.0",
  "description": "Sistema de Apoyo Inspectoría",
  "main": "main.js",
  "author": "Diego Saravia, Victor Jara",
  "scripts": {
    "start": "electron .",
    "build:front": "npm --prefix ../inspectoria-front run build",
    "prepare:back": "node scripts/prepare-back.js",
    "prepare:cloudflared": "node scripts/descargar-cloudflared.js",
    "pack": "npm run build:front && npm run prepare:back && npm run prepare:cloudflared && electron-builder --dir",
    "dist": "npm run build:front && npm run prepare:back && npm run prepare:cloudflared && electron-builder",
    "dist:win": "npm run build:front && npm run prepare:back && npm run prepare:cloudflared -- win && electron-builder --win",
    "dist:linux": "npm run build:front && npm run prepare:back && npm run prepare:cloudflared -- linux && electron-builder --linux",
    "//dist:linux": "Correr dist:linux en Linux: better-sqlite3 se compila para el sistema donde se ejecuta prepare-back"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "cl.inacap.apoyoinspectoria",
    "productName": "Apoyo Inspectoria",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "back-build",
        "to": "inspectoria-back",
        "filter": [
          "**/*",
          "node_modules/**/*",
          "!src/node_modules/**/*"
        ]
      },
      {
        "from": "back-build/src/node_modules",
        "to": "inspectoria-back/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "front-dist",
        "to": "front-dist"
      }
    ],
    "win": {
      "extraResources": [
        {
          "from": "bin/cloudflared.exe",
          "to": "bin/cloudflared.exe"
        }
      ],
      "target": "portable",
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "extraResources": [
        {
          "from": "browsers",
          "to": "browsers"
        },
        {
          "from": "bin/cloudflared",
          "to": "bin/cloudflared"
        }
      ],
      "target": "AppImage",
      "category": "Utility",
      "icon": "assets/icons/icon.png"
    }
  }
}
