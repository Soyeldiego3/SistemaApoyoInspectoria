# Dependencias
node_modules/

# Variables de entorno y credenciales
.env
.env.*
!.env.example

# Base de datos SQLite y archivos temporales de transacciones
*.db
*.db-shm
*.db-wal
data/*.db*
!data/.gitkeep
secret.key
portal.cred.json
app.config.json
respaldo.clave.json
